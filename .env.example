# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Generate App Key/Secret at the Webull developer site after API access is approved.
WEBULL_APP_KEY=your_app_key_here
WEBULL_APP_SECRET=your_app_secret_here

# Region: us | hk | jp ...  (this toolkit targets US)
WEBULL_REGION=us

# Environment: test (UAT) | prod (LIVE / real money).
# NOTE: a Webull developer-portal App Key is PROD-ONLY — the UAT host 404s it (see README/Gotchas),
# so this toolkit operates on prod. The env selects ONLY the endpoint host; it is NOT the order
# safety gate — a real order still requires confirm=True through one of the three AUTHORIZED
# exceptions (CLAUDE.md): the codeword-gated place_order MCP tool, the autopilot, or the day session
# — or the owner's own terminal, scripts/place_order.py (dry-run by default; --confirm arms it and it
# still submits only after a typed CONFIRM; the AI cannot run it with confirm=True).
WEBULL_ENV=prod

# Where the SDK stores the 2FA access token (gitignored). Keep out of version control.
WEBULL_OPENAPI_TOKEN_DIR=.webull-tokens

# Optional: earnings-date checks used by the judgment, RSI2 and setups services (Finnhub free
# tier). Omit and those degrade gracefully (best-effort earnings checks skip).
FINNHUB_API_KEY=your_finnhub_api_key_here

# --- Direct Desktop placing (webull-trade MCP place_order) — OPT-IN, off by default ---
# Set a secret codeword you'll type in chat to fire a direct order. Unset = place_order disabled.
# WEBULL_TRADE_CODEWORD=
# Per-order notional cap for direct placing (default 500 = your book). Bigger orders use draft_order.
# WEBULL_TRADE_MAX_NOTIONAL=500
# How long a SCHEDULED-routine draft (morning_routine) stays pending before it expires, in minutes.
# Interactive drafts keep their 30-min default; this only affects morning_routine. Default 240 (4h).
# WEBULL_ROUTINE_TTL_MIN=240

# ── Autopilot (autonomous placement) — ALL OFF by default; go-live needs a security review ──
# WEBULL_AUTOPILOT_ENABLED=false          # master switch; absent/false => nothing auto-places
# WEBULL_AUTOPILOT_MAX_NOTIONAL=40        # per-entry $ cap
# WEBULL_AUTOPILOT_MAX_POSITIONS=1        # max concurrent positions (incl. working entries)
# WEBULL_AUTOPILOT_MAX_ORDERS_PER_DAY=5   # daily placement ceiling (all sides)
# WEBULL_AUTOPILOT_DAILY_LOSS_HALT=40     # halt new BUYs once day P/L <= -$this
# WEBULL_AUTOPILOT_MAX_POSITIONS_RISK_OFF=0  # position cap when SPY < 200SMA
# WEBULL_AUTOPILOT_DIR=autopilot          # store root: state, audit log, AND the default kill-file live here; a RELATIVE value auto-anchors under the repo
# WEBULL_AUTOPILOT_KILL_FILE=autopilot/KILL  # halt file; RELATIVE auto-anchors to <repo>/autopilot/KILL. Set an ABSOLUTE path (e.g. a OneDrive folder) so you can create/delete it from your phone.
# WEBULL_AUTOPILOT_WINDOWS=17:00-20:00    # allowed local-time placement windows
# WEBULL_AUTOPILOT_NOTIFY=                # optional JSON webhook ({"text": summary}) for run summaries — NOT ntfy; the phone push below is separate
# WEBULL_AUTOPILOT_DECISIONS_ENABLED=false # DECISIONS stage: lets a run act on QUEUED executable rows (rsi2_real / owner queue) — the only path from a queue row to an order
# WEBULL_AUTOPILOT_MAX_DECISIONS_PER_DAY=3 # queued rows the DECISIONS stage may act on per day (default 3; the owner runs 4 for a 5-lot book)
# WEBULL_AUTOPILOT_COOLING_MINUTES=120     # cooling window between placements (default 120)
# WEBULL_OPTIONS_MAX_DEBIT=70              # autopilot options decisions: max debit $ per unit (default 70)
# WEBULL_OPTIONS_MAX_OPEN=2                # autopilot options decisions: max concurrent units (default 2)
# WEBULL_OPTIONS_MAX_DEBIT_FRAC_OF_WIDTH=0.65 # autopilot options decisions: reject a debit above this share of the spread width

# Optional: the ONE ntfy.sh topic every phone push goes to (2026-09-21): the evening manager's
# note (sectioned, attention-first, priority/tag follow its ATTENTION section), the autopilot's
# placement/error note, the suite watchdog, the bench feeder digest and a session-grid ticket.
# Plain text only (the phone apps render no Markdown); every body is held under ntfy's
# 4,096-byte attachment threshold. Absent => no pushes, everything else still runs.
# WEBULL_MANAGER_NOTE_NTFY=https://ntfy.sh/your-topic

# Healthchecks.io dead-man ping (watchdog extension 2026-07-28). The watchdog GETs this
# URL after every weekday EVENING assessment; the service alerts your phone when no ping
# arrives. Configure the check as CRON "0 19 * * 1-5", timezone America/New_York, grace 2h
# — a healthchecks cron expression describes WHEN THE JOB RUNS (the 7 PM watchdog task),
# not a deadline; setting it to 20:00 makes every 7 PM ping schedule a same-evening 20:00
# expectation that nothing satisfies, i.e. a false alarm every night. Grace sets the
# deadline (alerts ~21:00 when the ping never came). Empty/unset = external dead-man off.
WEBULL_WATCHDOG_HEALTHCHECK_URL=

# Optional: relocate ALL runtime data stores (data/<store>) in one move, e.g. for a
# dedicated always-on host. Per-store overrides still win — the full set:
# ACTIVITY_DIR · JOURNAL_DIR · LAB_DIR · PAPER_DIR · PRACTICE_DIR · STRATEGY_DIR ·
# ORDER_INTENTS_DIR · POSITION_PLANS_DIR · WEBULL_EXEC_DIR · RSI2_REAL_STATE_DIR ·
# WEBULL_SCANNER_DIR · RSI2_STATE_DIR.
# WEBULL_DATA_DIR=D:\webull-data

# Day-trade session runner (AUTHORIZED EXCEPTION #3 - BUILT, NOT ARMED; spec 2026-09-01).
# Codeword = opt-in + the session-start secret the OWNER types in chat (model never knows it).
# WEBULL_DAYTRADE_CODEWORD=
# Arming flag - leave unset for DRY (previews only). Set to 1 ONLY after >=3 clean DRY
# sessions + /security-review, per the arming checklist in the spec.
# WEBULL_DAYTRADE_ENABLED=0

# ── Tiingo depth path (Lab + backtest offline history; spec 2026-09-07-tiingo-depth-path-design.md §7) ──
# TIINGO_API_TOKEN=                       # from tiingo.com; offline 30-yr daily bars, Lab/backtest only, never logged
# WEBULL_LAB_BAR_SOURCE=webull            # webull (default) | tiingo
# WEBULL_LAB_LOOKBACK_BARS=750            # int >= 750 (default); see spec 2026-09-07-tiingo-depth-path-design.md §7 before raising

# ── Real-book RSI2 path (AUTHORIZED EXCEPTION #2 through the autopilot DECISIONS stage; spec 2026-08-15) ──
# rsi2_real_service runs inside the 17:30 paper suite and is QUEUE-ONLY: it writes executable BUY rows and
# never places; the next morning autopilot run places them behind gate.authorize + the caps above.
# WEBULL_RSI2_REAL_ENABLED=false          # truthy => queue one executable BUY per RSI(2) < 10 signal (ARMED by the owner 2026-09-14)
# WEBULL_RSI2_REAL_MAX_LOTS=1             # max open real RSI2 lots (owner: 5 since 2026-09-17)
# WEBULL_RSI2_REAL_DOLLARS=               # per-lot budget $; unset => whatever settled cash allows (owner: 420)
# RSI2_REAL_STATE_DIR=                    # real-book ledger dir override (default: the activity store)
# WEBULL_DECISIONS_FILE=                  # executable-decisions queue override (default data/activity/executable_decisions.jsonl)

# ── Paper suite switches ──
# WEBULL_OPTIONS_ENTRY_PAUSED=0           # 1 => options_entry_service opens nothing (paused since 2026-08-31, red-team #2)

# ── Claude through the CLI (entry-judgment shadow; Max-plan OAuth, NOT the API key) ──
# CLAUDE_CODE_OAUTH_TOKEN=                # from `claude setup-token`; the child env has ANTHROPIC_API_KEY scrubbed
# WEBULL_JUDGMENT_CLAUDE_BIN=             # path to the claude executable when it is not on PATH
# WEBULL_JUDGMENT_MODEL=opus              # model alias handed to the CLI for the judgment shadow
